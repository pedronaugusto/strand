.{
    .name = .strand,
    .version = "0.7.0",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0x9a4b2ab5656b3f0,
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
    },
    .dependencies = .{
        // Syncing a file and telling files apart. Pinned to a commit; the
        // hash is what the build checks.
        .airlock = .{
            .url = "git+https://github.com/pedronaugusto/airlock#b0d1a413c496fab6f08163cffcd55a8cab1075ac",
            .hash = "airlock-0.1.0-rfvu6JWGBQDtnYrvq5Yc59eVYr1E6l4-jRzZinJfCusT",
        },
        // Types that make the checked work in the core safe by construction:
        // finite budgets, checked arithmetic, closed public diagnostics and
        // always-on contracts. std only, pinned to a commit.
        .aegis = .{
            .url = "git+https://github.com/pedronaugusto/aegis#28e8df5b3fde1fca2d5b61f6ab110c4acac2f688",
            .hash = "aegis-0.0.0-rsxougITBwB_VYWvOCMfzQ4ra79s9U5QTAiuKH6ZWOl5",
        },
        // Test doubles, for the tests alone: no module a consumer builds
        // imports it, and a consumer never fetches it.
        .shakedown = .{
            .url = "git+https://github.com/pedronaugusto/shakedown#18445cd52dc898766310a609db652eb0a1647f58",
            .hash = "shakedown-0.1.0-BR8U43ozFQD8gJV56m19Dvgj99tRNxyD_vmnKNzssMVy",
            .lazy = true,
        },
        .preflight = .{
            .url = "git+https://github.com/pedronaugusto/preflight#cb348117bc08b298276d51a00dbbfe83e79570a7",
            .hash = "preflight-0.1.0-LX1ZwtKECgCyqcfgCDqfVAt-b2a1rEXMuKMEXzv4a0up",
            .lazy = true,
        },
    },
}
