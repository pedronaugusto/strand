    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
    },
    .dependencies = .{
        // Syncing a file and telling files apart. Pinned to a commit; the
