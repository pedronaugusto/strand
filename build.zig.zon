            .url = "git+https://github.com/pedronaugusto/shakedown#d95deb1d8859416f23689440b1af5da3d034860e",
            .hash = "shakedown-0.1.0-BR8U45NvFQB7Z_VGFcneyHXmB5wYCSM73NQLSpQkx4UB",
            .lazy = true,
