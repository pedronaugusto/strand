.{
    .name = .strand,
    .version = "0.7.0",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0x9a4b2ab5656b3f0,
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
    },
    .dependencies = .{
        // Syncing a file and telling files apart. Pinned to a commit; the
        // hash is what the build checks.
        .airlock = .{
            .url = "git+https://github.com/pedronaugusto/airlock#a19d4f4e6825a49fc61478c14718414fb190a324",
            .hash = "airlock-0.1.0-rfvu6JWGBQCN3u7evgacrcGxb7KYWMxQ-cxp8jviJKOD",
        },
        // Types that make the checked work in the core safe by construction:
        // finite budgets, checked arithmetic, closed public diagnostics and
        // always-on contracts. std only, pinned to a commit.
        .aegis = .{
            .url = "git+https://github.com/pedronaugusto/aegis#be2523ffd337fa31b5336e6f652f642c43622471",
            .hash = "aegis-0.0.0-rsxoutrdBgCSI4l3iGMCx8rEymViUGaDM3yuGFI3z01T",
        },
        // Test doubles, for the tests alone: no module a consumer builds
        // imports it, and a consumer never fetches it.
        .shakedown = .{
            .url = "git+https://github.com/pedronaugusto/shakedown#caf380381a49ace7c13beba70dd512c4faf24ce7",
            .hash = "shakedown-0.1.0-BR8U4yVfEgCS2Vw6zWMqw0wRjxct8g3tePy1UKNZ8Q89",
            .lazy = true,
        },
        .preflight = .{
            .url = "git+https://github.com/pedronaugusto/preflight#eade5faba539aaf9f6c48f63adc2545ba63d43d8",
            .hash = "preflight-0.1.0-LX1ZwqYKCgC0_Jaox-JCVqBAuBdonuFTdCNZs3OM4KBB",
            .lazy = true,
        },
    },
}
