.{
    .name = .strand,
    .version = "0.15.0",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0x9a4b2ab5656b3f0,
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
    },
    .dependencies = .{
        // Syncing a file and telling files apart. Pinned to a commit; the
        // hash is what the build checks.
        .airlock = .{
            .url = "git+https://github.com/pedronaugusto/airlock#f0b59c41348ad772c984753ea819f9345a37130d",
            .hash = "airlock-0.6.0-rfvu6PdDCAChN1RPjYEz_v65zNQ-wOiR6ANrRrxzIWLH",
        },

        // Types that make the checked work in the core safe by construction:
        // finite budgets, checked arithmetic, closed public diagnostics and
        // always-on contracts. std only, pinned to a commit.
        .aegis = .{
            .url = "git+https://github.com/pedronaugusto/aegis#3c0b13e5fc25797b5fbcc25fec48b0a8411cc668",
            .hash = "aegis-0.2.4-rsxoug3uCwBiVYRBbQolOSbqdOEzmmUeaj19tWOo2rmc",
        },

        // Unicode's simple case folding, for member names read by folding.
        .xenoglyph = .{
            .url = "git+https://github.com/pedronaugusto/xenoglyph#d6432607111da5deb5f0a481d1674da990872c96",
            .hash = "xenoglyph-0.5.1-YKXZlXX6RgBGRl07HQns6W6M42ZLEP22hg8cEY37HouP",
        },

        // Test doubles, for the tests alone: no module a consumer builds
        // imports it, and a consumer never fetches it.

    },
    .dev_dependencies = .{
        // The W3C XML Conformance Test Suite, fetched from the W3C for the
        // tests alone: its parts' licences allow no other redistribution.
        .xmlts = .{
            .url = "https://www.w3.org/XML/Test/xmlts20130923.tar.gz",
            .hash = "N-V-__8AAKKMKQAyL3KQidU3H84LB3ftuZRsxUo4mqNyyHnZ",
            .lazy = true,
        },

        .preflight = .{
            .url = "git+https://github.com/pedronaugusto/preflight?ref=v0.18.3#c253c7b7b9f0a9e6ccf02357494eb4cce7664cf4",
            .hash = "preflight-0.18.3-LX1Zwn_UEwBDhK-WvHl1kBupXsPvCT7UHfbNvh9ZPrKL",
        },

        .shakedown = .{
