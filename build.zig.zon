        .aegis = .{
            .url = "git+https://github.com/pedronaugusto/aegis?ref=v0.2.2#17b0bde5486f61b3786272219231cfa1f8b67c10",
            .hash = "aegis-0.2.2-rsxoumb0CAA6g5peyPparEP4gU0iQNa4N3eUGPruujSn",
        },

        // Unicode's simple case folding, for member names read by folding.
        .xenoglyph = .{
            .url = "git+https://github.com/pedronaugusto/xenoglyph?ref=v0.5.1#47cce65a205158f3a9d64a78be763ee5cee744cc",
            .hash = "xenoglyph-0.5.1-YKXZlRfgRgA-8yyLTWXsJNDfnimXJi_WG7n959GPPr4U",
        },

        // Test doubles, for the tests alone: no module a consumer builds
        // imports it, and a consumer never fetches it.

    },
