.{
    .name = .strand,
    .version = "0.13.1",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0x9a4b2ab5656b3f0,
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
    },
    .dependencies = .{
        // Syncing a file and telling files apart. Pinned to a commit; the
        // hash is what the build checks.
        .airlock = .{
            .url = "git+https://github.com/pedronaugusto/airlock?ref=v0.5.0#7f762143644bc2464e7a7e1544af7c5572f5f5a7",
            .hash = "airlock-0.5.0-rfvu6Bq4BgClxCu1P8SDSU9WW0WOMd6jYDjtfasSIGEi",
        },

        // Types that make the checked work in the core safe by construction:
        // finite budgets, checked arithmetic, closed public diagnostics and
        // always-on contracts. std only, pinned to a commit.
        .aegis = .{
            .url = "git+https://github.com/pedronaugusto/aegis?ref=v0.1.18#c6fd0e2501b553af60256669df0ee15176ed21ce",
            .hash = "aegis-0.1.18-rsxounuqCAA3bG0JhLkfilLi4zBvhm9QTeUkT1U4UBr5",
        },

        // Unicode's simple case folding, for member names read by folding.
        .xenoglyph = .{
            .url = "git+https://github.com/pedronaugusto/xenoglyph?ref=v0.4.2#8aed75bd7544bae9858799f0f29e2eab1e3b2801",
            .hash = "xenoglyph-0.4.2-YKXZla8pGwCdQVFVWrrij3Eu8CZreypuVrHD_jsDTwAo",
        },

        // Test doubles, for the tests alone: no module a consumer builds
        // imports it, and a consumer never fetches it.

    },
    .dev_dependencies = .{
        // The W3C XML Conformance Test Suite, fetched from the W3C for the
        // tests alone: its parts' licences allow no other redistribution.
        .xmlts = .{
            .url = "https://www.w3.org/XML/Test/xmlts20130923.tar.gz",
            .hash = "N-V-__8AAKKMKQAQZYwJKc3HXn2lz0rK8Zmh5VNdtUCcKLtY",
            .lazy = true,
        },

        .preflight = .{
            .url = "git+https://github.com/pedronaugusto/preflight?ref=v0.17.0#d4b591746fea0a2354322967f0513b2a43cd0b04",
            .hash = "preflight-0.17.0-LX1ZwiU1EgCWQT4q8WKiwM-7LGFaQ1iuFgCgTh-fR6HF",
        },

        .shakedown = .{
