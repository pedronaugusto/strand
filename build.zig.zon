.{
    .name = .strand,
    .version = "0.15.0",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0x9a4b2ab5656b3f0,
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
    },
    .dependencies = .{
        // Syncing a file and telling files apart. Pinned to a commit; the
        // hash is what the build checks.
        .airlock = .{
            .url = "git+https://github.com/pedronaugusto/airlock#3ef2f541e9c487e62dd588d5675199d77bbca1ec",
            .hash = "airlock-0.6.0-rfvu6CbQCAB-yuZ--fdaXpnGAsCzkaeqnDWRLuQUcAgH",
        },

        // Types that make the checked work in the core safe by construction:
        // finite budgets, checked arithmetic, closed public diagnostics and
        // always-on contracts. std only, pinned to a commit.
        .aegis = .{
            .url = "git+https://github.com/pedronaugusto/aegis#f52eabef3ec6534c3a74bea3a3b7d95a91ce2581",
            .hash = "aegis-0.2.4-rsxouoquDQApwYDuGdd2YyEeTeNp6CnJoOZKdVCfc3jt",
        },

        // Unicode's simple case folding, for member names read by folding.
        .xenoglyph = .{
            .url = "git+https://github.com/pedronaugusto/xenoglyph#ab4d38189cb723e4f102b611ed818380da56c750",
            .hash = "xenoglyph-0.5.1-YKXZlcMCVABOnefwWET72nJLsmnBsMepiQwrB2Ll5HI9",
        },

        // uplink's codecs, `uplink.wire`, for strand_schema's URI references:
        // fetched only by a build with `.schema = true`, without the client.
        .uplink = .{
            .url = "git+https://github.com/pedronaugusto/uplink#e3cd60c58605b738c46b7e422c0e475afee33c1c",
            .hash = "uplink-0.10.2-0eVSJgi2HgAcbj3U8OV7T4bs5-JxtGE2YVAR4RgX9GWG",
            .lazy = true,
        },

        // ECMAScript patterns in linear time, for strand_schema's `pattern`,
        // `patternProperties` and the `regex` format: fetched only by a build
        // with `.schema = true`.
        .spectra = .{
            .url = "git+https://github.com/pedronaugusto/spectra#6dd0ffa18803ca10bd71315b6194064d2bc02056",
            .hash = "spectra-0.0.0-t6DGCEXiDQDH7cmxrR5H6k3LrmHxPIzeISlgsRqiMzg9",
            .lazy = true,
        },

        // RFC 3339's grammar, for strand_schema's `date-time`, `date`, `time`
        // and `duration` formats: fetched only by a build with `.schema = true`.
        .almanac = .{
            .url = "git+https://github.com/pedronaugusto/almanac#514f562cda12d4a6fb2915afe146a4474151bc6f",
            .hash = "almanac-0.0.0-sQeSOWtoCgDbTpJJ6xIDc7nridOruMC_DFStdIuDe_z8",
            .lazy = true,
        },

        // Test doubles, for the tests alone: no module a consumer builds
        // imports it, and a consumer never fetches it.

    },
    .dev_dependencies = .{
        // The W3C XML Conformance Test Suite, fetched from the W3C for the
        // tests alone: its parts' licences allow no other redistribution.
        .xmlts = .{
            .url = "https://www.w3.org/XML/Test/xmlts20130923.tar.gz",
            .hash = "N-V-__8AAKKMKQAyL3KQidU3H84LB3ftuZRsxUo4mqNyyHnZ",
            .lazy = true,
        },

        // The JSON-Schema-Test-Suite, for strand_schema's tests alone.
        .json_schema_test_suite = .{
            .url = "git+https://github.com/json-schema-org/JSON-Schema-Test-Suite#38dea932b02986f496345bf007108277777630bf",
            .hash = "N-V-__8AAM4EEACCaWf61qxGMqrrNghGcq_MHInO3gTd63XY",
            .lazy = true,
        },

        .preflight = .{
            .url = "git+https://github.com/pedronaugusto/preflight?ref=ci-standard#158c1763b4142ac13715fb2b89d11fd46a1b4bed",
            .hash = "preflight-0.18.6-LX1ZwskrHABgr9REQqYovipaEjRJIeV0GZNu-1rrr3dR",
        },

        .shakedown = .{
            .url = "git+https://github.com/pedronaugusto/shakedown#c29751d199924501be180c7cb476c553e5f94db4",
            .hash = "shakedown-0.6.0-BR8U42rTGwCuOugyQpcemTBDqCsRl7uXESZcMWWpqVgb",
        },
    },
}
