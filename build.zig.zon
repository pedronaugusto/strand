        .airlock = .{
            .url = "git+https://github.com/pedronaugusto/airlock?ref=v0.6.0#0931b6512b1d7c2e03e822bc82870ec8f98fa91e",
            .hash = "airlock-0.6.0-rfvu6JUEBwD8DeigCmlj5NDNiglUZzUy2HSsKAeYRs3E",
        },

        // Types that make the checked work in the core safe by construction:
        // finite budgets, checked arithmetic, closed public diagnostics and
