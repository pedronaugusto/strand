        .airlock = .{
            .url = "git+https://github.com/pedronaugusto/airlock#3bd76f4143c90491c459f3673c44e80dc5dce6de",
            .hash = "airlock-0.1.0-rfvu6JWGBQDnJgHdK2V7IPnribpvkrn4uHh1hGAXvD62",
        },
        // Types that make the checked work in the core safe by construction:
        // finite budgets, checked arithmetic, closed public diagnostics and
        // always-on contracts. std only, pinned to a commit.
        .aegis = .{
            .url = "git+https://github.com/pedronaugusto/aegis#d364f80a4e5e9ae4c0ea4735336383da268ff24c",
            .hash = "aegis-0.0.0-rsxougITBwCZsF9Qy82pq-gvba1nwTTK28cL4uZPV3Qq",
        },
        // Test doubles, for the tests alone: no module a consumer builds
        // imports it, and a consumer never fetches it.
