.{
    .name = .strand,
    .version = "0.15.0",
    .minimum_zig_version = "0.17.0",
    .fingerprint = 0x9a4b2ab5656b3f0,
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "src",
        "CHANGELOG.md",
        "LICENSE",
        "README.md",
    },
    .dependencies = .{
        // Syncing a file and telling files apart. Pinned to a commit; the
        // hash is what the build checks.
        .airlock = .{
            .url = "git+https://github.com/pedronaugusto/airlock#55f0265ad74ceff3ea14a1fca316f82aa3f45ae8",
            .hash = "airlock-0.6.0-rfvu6DdECADPsZW3JjI6jPRt-hpplrgrRaA4M4Ey7e8W",
        },

        // Types that make the checked work in the core safe by construction:
        // finite budgets, checked arithmetic, closed public diagnostics and
        // always-on contracts. std only, pinned to a commit.
        .aegis = .{
            .url = "git+https://github.com/pedronaugusto/aegis#dc3ed602f9c18b4473e9c649d1b1f36403603018",
            .hash = "aegis-0.2.4-rsxouheoDQB7ckAmyiNbPdOdlqJnN1Sj56bM7_iPKhpY",
        },

        // Unicode's simple case folding, for member names read by folding.
        .xenoglyph = .{
            .url = "git+https://github.com/pedronaugusto/xenoglyph#22f2b4957029e25c8fe8b60429a12e8550f83a90",
            .hash = "xenoglyph-0.5.1-YKXZlbIBVABfd34rUsU2tEzrxgp25K-u-5BQv5X0DELi",
        },

        // uplink's codecs, `uplink.wire`, for strand_schema's URI references:
        // fetched only by a build with `.schema = true`, without the client.
        .uplink = .{
            .url = "git+https://github.com/pedronaugusto/uplink#b81dc35b8adc122e3a27cd9872d2091abc04b5dc",
            .hash = "uplink-0.10.2-0eVSJjwpHgCtI2cKjfjq9eP3vSAsV6C5p0eFHy45GdiX",
            .lazy = true,
        },

        // ECMAScript patterns in linear time, for strand_schema's `pattern`,
        // `patternProperties` and the `regex` format: fetched only by a build
        // with `.schema = true`.
        .spectra = .{
            .url = "git+https://github.com/pedronaugusto/spectra#4bca7e9c8e114118efdf481b1129bab91244bd10",
            .hash = "spectra-0.0.0-t6DGCKjWDQDiWNUc4QBvHPUwHfY-VYM2VmQ2r2BneFDr",
            .lazy = true,
        },

        // RFC 3339's grammar, for strand_schema's `date-time`, `date`, `time`
        // and `duration` formats: fetched only by a build with `.schema = true`.
        .almanac = .{
            .url = "git+https://github.com/pedronaugusto/almanac#c11d303e8e9b551df0e37ae584a0273a841588a4",
            .hash = "almanac-0.0.0-sQeSOc1jCgDnM3kPCQGesykZXF9b2x3mB06ENUKE-RLl",
            .lazy = true,
        },

        // Test doubles, for the tests alone: no module a consumer builds
        // imports it, and a consumer never fetches it.

    },
    .dev_dependencies = .{
        // The W3C XML Conformance Test Suite, fetched from the W3C for the
        // tests alone: its parts' licences allow no other redistribution.
        .xmlts = .{
            .url = "https://www.w3.org/XML/Test/xmlts20130923.tar.gz",
            .hash = "N-V-__8AAKKMKQAyL3KQidU3H84LB3ftuZRsxUo4mqNyyHnZ",
            .lazy = true,
        },

        // The JSON-Schema-Test-Suite, for strand_schema's tests alone.
        .json_schema_test_suite = .{
            .url = "git+https://github.com/json-schema-org/JSON-Schema-Test-Suite#38dea932b02986f496345bf007108277777630bf",
            .hash = "N-V-__8AAM4EEACCaWf61qxGMqrrNghGcq_MHInO3gTd63XY",
            .lazy = true,
        },

        .preflight = .{
            .url = "git+https://github.com/pedronaugusto/preflight?ref=ci-standard#c2f1d775a45316a76daf72dcb750c6e343044669",
            .hash = "preflight-0.18.6-LX1Zwnx5GgBnUYhYaAz0DeHp5cCfPuk26cNqFFyW7EEJ",
        },

        .shakedown = .{
            .url = "git+https://github.com/pedronaugusto/shakedown#9005b65d81e8efab8bda86bf5001de6351717fe0",
            .hash = "shakedown-0.6.0-BR8U40gRGwA1j8mnIfkc4u_U4meNZwr9_YRrNv4zVzTM",
        },
    },
}
